# ── Application ────────────────────────────────────────────────────────────
# Public base URL used for canonical links, robots.txt and sitemap.xml.
APP_URL=http://46.173.16.90

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Shared by the app (system of record) and Forgejo (its own schema).
POSTGRES_DB=rca_vostok
POSTGRES_USER=rca
POSTGRES_PASSWORD=change_me_strong_random_password

# ── Forgejo ────────────────────────────────────────────────────────────────
FORGEJO_DB_NAME=forgejo
FORGEJO_DOMAIN=46.173.16.90
FORGEJO_ROOT_URL=http://46.173.16.90/git/

# ── Garage S3 ──────────────────────────────────────────────────────────────
# These must match deploy/garage.toml.
GARAGE_RPC_SECRET=change_me_64_hex_chars
GARAGE_ADMIN_TOKEN=change_me_admin_token
GARAGE_METRICS_TOKEN=change_me_metrics_token

# Access key pair created once via `garage key create`; used by the backup job
# and by Forgejo for repository archives.
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=
GARAGE_S3_BUCKET=rca-vostok-backups

# ── Media object storage (feed covers, chat attachments, albums) ───────────
# Separate bucket so user media is pruned independently of DB backups.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=rca-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How the app reaches uploaded files: it proxies them at /media/<assetId>.
S3_PUBLIC_BASE_URL=/media

# ── NATS (optional event bus) ─────────────────────────────────────────────
# When unreachable the app degrades to an in-memory bus automatically.
NATS_URL=nats://nats:4222
