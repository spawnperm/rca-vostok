{
  "name": "@nexus-plugins/tinacms-sales-playbooks",
  "version": "1.3.0",
  "description": "Contextual sales playbook matching domain service bridging TinaCMS content blocks into CRM deals.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "dependencies": {
    "@nexus-core/ddd-kernel": "*",
    "zod": "^4.6.7"
  },
  "nexusModule": {
    "boundedContext": "cms",
    "contextMapping": "Customer-Supplier",
    "role": "plugin-module",
    "slot": "crm_deal_sidebar",
    "aggregates": [
      "SalesPlaybookBlock"
    ],
    "valueObjects": [
      "PlaybookMatchScore"
    ],
    "domainEvents": [
      "cms.<tenant>.playbook.matched"
    ],
    "subscribedSubjects": [
      "crm.*.deal.moved"
    ],
    "permissionsRequired": [
      "deals:read",
      "cms:edit"
    ]
  },
  "license": "Apache-2.0"
}
