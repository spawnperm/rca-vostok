{
  "name": "@nexus-core/ddd-kernel",
  "version": "1.0.0",
  "description": "Shared Kernel tactical DDD building blocks (AggregateRoot, Entity, ValueObject, DomainEvent, BoundedContextManifest) for NexusHarness modules.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "nexusModule": {
    "boundedContext": "shared-kernel",
    "contextMapping": "Shared Kernel",
    "role": "shared-kernel",
    "aggregates": ["AggregateRoot", "Entity"],
    "valueObjects": ["ValueObject", "Money", "SubdomainSlug", "VerdaccioPackageName"],
    "domainEvents": ["DomainEventEnvelope"],
    "subscribedSubjects": [],
    "permissionsRequired": []
  },
  "license": "Apache-2.0"
}
