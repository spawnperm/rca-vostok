{
  "name": "@nexus-plugins/nats-webhook-bridge",
  "version": "2.1.0",
  "description": "NATS JetStream subject filtering, retry backoff policy, and webhook envelope adapter module.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "dependencies": {
    "@nexus-core/ddd-kernel": "*",
    "zod": "^4.6.7"
  },
  "nexusModule": {
    "boundedContext": "integration",
    "contextMapping": "Published Language",
    "role": "plugin-module",
    "slot": "crm_toolbar",
    "aggregates": [
      "WebhookSubscription"
    ],
    "valueObjects": [
      "WebhookRetryPolicy",
      "NatsSubjectPattern"
    ],
    "domainEvents": [
      "integration.<tenant>.webhook.dispatched"
    ],
    "subscribedSubjects": [
      "crm.*.deal.*",
      "crm.*.email.sent"
    ],
    "permissionsRequired": [
      "deals:write"
    ]
  },
  "license": "Apache-2.0"
}
