{
  "name": "@nexus-plugins/dify-deal-copilot",
  "version": "1.4.2",
  "description": "AI deal scoring, risk classification, and next-step recommendation bounded module for NexusHarness CRM.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "dependencies": {
    "@nexus-core/ddd-kernel": "*",
    "zod": "^4.6.7"
  },
  "nexusModule": {
    "boundedContext": "crm",
    "contextMapping": "Customer-Supplier",
    "role": "plugin-module",
    "slot": "crm_deal_sidebar",
    "aggregates": [
      "DealScoringAssessment"
    ],
    "valueObjects": [
      "WinProbability",
      "RiskTier"
    ],
    "domainEvents": [
      "crm.<tenant>.deal.scored"
    ],
    "subscribedSubjects": [
      "crm.*.deal.created",
      "crm.*.deal.moved",
      "crm.*.timeline.message"
    ],
    "permissionsRequired": [
      "deals:read",
      "harness:execute"
    ]
  },
  "license": "Apache-2.0"
}
