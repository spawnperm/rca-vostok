@nexus-core:registry=http://localhost:4873/
@nexus-plugins:registry=http://localhost:4873/
always-auth=false
; @mattermost/client declares peerOptional typescript "^4.3.0 || ^5.0.0"
; while the project intentionally runs TypeScript 7 (native port). The peer is
; type-only and safe to relax; without this flag `npm install` fails with ERESOLVE.
legacy-peer-deps=true
