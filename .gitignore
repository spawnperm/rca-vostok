node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
/data/
/logs/

# pnpm's local state
.pnpm-store/
.pnpm-debug.log*

# Lockfiles.
#
# package-lock.json IS committed: the project installs with npm, and without a
# committed lockfile every CI run and every image build resolves dependency
# versions from the ^ ranges in package.json. That means a release can change
# without a single commit, and a build that passed yesterday can fail today.
#
# npm was migrated from pnpm in d67e17e, which deleted pnpm-lock.yaml but left
# this file ignoring package-lock.json — so for a while nothing was pinned at
# all. Only genuinely foreign lockfiles are ignored now.
yarn.lock
bun.lock

# Agent/runtime state written into the working directory (Mnemon memory store).
# It is per-machine data, not source.
.mnemon/

# Operational secrets generated on a deployment host (Forgejo API password and
# access token used by maintenance scripts). They live beside the compose file
# and must never be committed: `git add -A` would otherwise publish them.
.forgejo-api-pass
.forgejo-token

# Deploy bookkeeping written by deploy/release.sh on the server (which commit is
# running, which image to roll back to). Per-host runtime state, not source.
.current-sha
.last-good-sha
