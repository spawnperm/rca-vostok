{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@nexus-core/ddd-kernel": [
        "./packages/ddd-kernel/src/index.ts"
      ],
      "@nexus-plugins/dify-deal-copilot": [
        "./packages/dify-deal-copilot/src/index.ts"
      ],
      "@nexus-plugins/nats-webhook-bridge": [
        "./packages/nats-webhook-bridge/src/index.ts"
      ],
      "@nexus-plugins/vk-social-polls": [
        "./packages/vk-social-polls/src/index.ts"
      ],
      "@nexus-plugins/directus-bi-connector": [
        "./packages/directus-bi-connector/src/index.ts"
      ],
      "@nexus-plugins/tinacms-sales-playbooks": [
        "./packages/tinacms-sales-playbooks/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist"]
}
