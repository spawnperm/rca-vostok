# Build artifacts and dependencies
node_modules
dist
build
coverage

# Foreign lockfiles. package-lock.json is deliberately NOT ignored: the image
# installs with `npm ci`, which needs it inside the build context. Ignoring it
# was left over from the pnpm era and made every image build resolve fresh
# versions instead of the ones CI had verified.
yarn.lock
bun.lock

# Local data and log stores created at runtime (root only: src/data holds source code)
/data
/logs

# VCS / tooling
.git
.gitignore
.github

# Wiki is documentation only; not needed inside the image
wiki

# Local env files and container overrides
.env
.env.*
*.log

# Editor / OS noise
.DS_Store
.vscode
.idea
